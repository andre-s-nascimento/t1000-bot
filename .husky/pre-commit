#!/bin/sh

echo "🔍 Verificando arquivos proibidos..."

# Bloquear .env
if git diff --cached --name-only | grep -E '(^|/)\.env' | grep -v '\.env\.example$'; then
  echo "❌ ERRO: .env não pode ser commitado!"
  exit 1
fi

# Bloquear script sensível
if git diff --cached --name-only | grep -E 'obter-refresh-token\.sh'; then
  echo "❌ ERRO: Script com credenciais detectado!"
  exit 1
fi

# Detectar secrets reais (ignorando placeholders e exemplos com ...)
if git diff --cached | grep -E '(CLIENT_SECRET|API_KEY|PRIVATE_KEY|TOKEN)=.{10,}' | grep -v -E '\$\{|\.\.\.'; then
  echo "❌ ERRO: Possível secret REAL detectado!"
  exit 1
fi

echo "🧹 Rodando spotlessApply (formatando código Java)..."
./gradlew spotlessApply --no-configuration-cache

# Verifica se o commitlint local existe
if [ -x "./node_modules/.bin/commitlint" ]; then
  echo "🧹 Rodando commitlint..."
  ./node_modules/.bin/commitlint --edit "$1" 2>/dev/null || true
else
  echo "⚠️ commitlint local não encontrado — pulando (rode 'npm install' para corrigir)"
fi

# Verifica se o lint-staged local existe
if [ -x "./node_modules/.bin/lint-staged" ]; then
  echo "🧹 Rodando lint-staged para os demais arquivos..."
  ./node_modules/.bin/lint-staged
else
  echo "⚠️ lint-staged local não encontrado — pulando (rode 'npm install' para corrigir)"
  echo "   Dica: 'npm install --save-dev lint-staged' e depois 'npm install --ignore-scripts'"
fi

echo "✅ Commit seguro"